# STAGE 1: dependências + build do monorepo
FROM node:22-alpine AS builder
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/backend/package.json ./packages/backend/
COPY apps/web/package.json ./apps/web/
COPY apps/mobile/package.json ./apps/mobile/
RUN --mount=type=cache,target=/root/.npm npm ci --omit=dev --workspace @movo/brasil --workspace @movo/web --fetch-retries=8 --fetch-retry-mintimeout=10000 --fetch-retry-maxtimeout=120000 --maxsockets=3 --no-audit --no-fund
COPY packages/backend ./packages/backend
COPY apps/web ./apps/web
RUN npm --workspace @movo/brasil run build
RUN npm --workspace @movo/web run build

# STAGE 2: runtime mínimo (Next standalone)
FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
# Higiene de supply chain (Gate 4): o runtime standalone não usa npm —
# remover elimina as CVEs do npm embarcado (tar/brace-expansion); upgrade
# do libcrypto3/openssl pega fixes do repositório alpine.
RUN apk upgrade --no-cache libcrypto3 openssl && rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx
RUN addgroup -S movo && adduser -S movo -G movo
COPY --from=builder --chown=movo:movo /app/apps/web/.next/standalone ./
COPY --from=builder --chown=movo:movo /app/apps/web/.next/static ./apps/web/.next/static
USER movo
EXPOSE 3000
ENV PORT=3000
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD wget -qO- http://127.0.0.1:3000/api/health | grep -q healthy
CMD ["node", "apps/web/server.js"]
